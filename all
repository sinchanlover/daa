class Ping extends Thread {

    public void run() {

        while (true) {

            System.out.println("Ping");

            try {
                sleep(1000);
            } catch (Exception e) {
            }
        }
    }
}

class Pong extends Thread {

    public void run() {

        while (true) {

            System.out.println("PONG");

            try {
                sleep(1000);
            } catch (Exception e) {
            }
        }
    }
}

public class Main {

    public static void main(String args[]) {

        Ping p1 = new Ping();
        Pong p2 = new Pong();

        p1.start();
        p2.start();
    }
}



class Buffer {

    int data;
    boolean valueSet = false;

    synchronized void produce(int value) {

        while (valueSet) {

            try {
                wait();
            } catch (Exception e) {
            }
        }

        data = value;

        System.out.println("Produced : " + data);

        valueSet = true;

        notify();
    }

    synchronized void consume() {

        while (!valueSet) {

            try {
                wait();
            } catch (Exception e) {
            }
        }

        System.out.println("Consumed : " + data);

        valueSet = false;

        notify();
    }
}

class Producer extends Thread {

    Buffer b;

    Producer(Buffer b) {
        this.b = b;
    }

    public void run() {

        int i = 1;

        while (true) {

            b.produce(i);

            i++;

            try {
                sleep(1000);
            } catch (Exception e) {
            }
        }
    }
}

class Consumer extends Thread {

    Buffer b;

    Consumer(Buffer b) {
        this.b = b;
    }

    public void run() {

        while (true) {

            b.consume();

            try {
                sleep(1000);
            } catch (Exception e) {
            }
        }
    }
}

public class Main {

    public static void main(String args[]) {

        Buffer b = new Buffer();

        Producer p = new Producer(b);
        Consumer c = new Consumer(b);

        p.start();
        c.start();
    }
}



import java.util.Scanner;

class MaxThread extends Thread {

    int arr[];
    int max;

    MaxThread(int arr[]) {
        this.arr = arr;
    }

    public void run() {

        max = arr[0];

        for (int i = 1; i < arr.length; i++) {

            if (arr[i] > max) {
                max = arr[i];
            }
        }
    }

    int getMax() {
        return max;
    }
}

class AvgThread extends Thread {

    int arr[];
    double avg;

    AvgThread(int arr[]) {
        this.arr = arr;
    }

    public void run() {

        int sum = 0;

        for (int i = 0; i < arr.length; i++) {
            sum = sum + arr[i];
        }

        avg = (double) sum / arr.length;
    }

    double getAvg() {
        return avg;
    }
}

public class Main {

    public static void main(String args[]) throws Exception {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter size of array: ");
        int n = sc.nextInt();

        int arr[] = new int[n];

        System.out.println("Enter array elements:");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        MaxThread t1 = new MaxThread(arr);
        AvgThread t2 = new AvgThread(arr);

        t1.start();
        t2.start();

        t1.join();
        t2.join();

        double result = t1.getMax() / t2.getAvg();

        System.out.println("Maximum = " + t1.getMax());

        System.out.println("Average = " + t2.getAvg());

        System.out.println("Result = " + result);
    }
}
